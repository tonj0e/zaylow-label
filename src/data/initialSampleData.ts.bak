// Generate 50 realistic demo orders programmatically to support large-scale search, pagination & testing
const sampleNames = ['Rohan Das', 'Kavita Singh', 'Harish Malhotra', 'Meera Joshi', 'Siddharth Rao', 'Deepak Chauhan', 'Shruti Saxena', 'Karan Gupta', 'Pooja Agarwal', 'Manish Pandit', 'Neha Sen', 'Rahul Deshmukh', 'Tarun Bansal', 'Shweta Kulkarni', 'Saurabh Tandon'];
const sampleCities = [
  { city: 'Mumbai', state: 'Maharashtra', pin: '400001', district: 'Mumbai' },
  { city: 'Jaipur', state: 'Rajasthan', pin: '302001', district: 'Jaipur' },
  { city: 'Lucknow', state: 'Uttar Pradesh', pin: '226001', district: 'Lucknow' },
  { city: 'Indore', state: 'Madhya Pradesh', pin: '452001', district: 'Indore' },
  { city: 'Surat', state: 'Gujarat', pin: '395001', district: 'Surat' },
  { city: 'Coimbatore', state: 'Tamil Nadu', pin: '641001', district: 'Coimbatore' },
  { city: 'Nagpur', state: 'Maharashtra', pin: '440001', district: 'Nagpur' },
  { city: 'Patna', state: 'Bihar', pin: '800001', district: 'Patna' }
];

const sampleProducts = [
  { name: 'ZAYLOW Wireless Noise Canceling Headphones', sku: 'ZYL-AUD-ANC-01', price: 4999, w: 0.5 },
  { name: 'ZAYLOW Active Stretch Cargo Joggers - Camo (M)', sku: 'ZYL-JOG-CAM-M', price: 2199, w: 0.48 },
  { name: 'ZAYLOW Smart Fitness Band 5 Pro', sku: 'ZYL-FIT-BND-05', price: 2999, w: 0.22 },
  { name: 'ZAYLOW Merino Wool Knit Beanie - Charcoal', sku: 'ZYL-HAT-WOL-CHA', price: 899, w: 0.15 },
  { name: 'ZAYLOW Ergonomic Laptop Stand - Anodized Gray', sku: 'ZYL-ACC-LAP-ST', price: 1799, w: 0.85 }
];

const couriersList: ('Delhivery' | 'DTDC' | 'India Post' | 'Shiprocket' | 'NimbusPost' | 'Bluedart')[] = ['Delhivery', 'DTDC', 'India Post', 'Shiprocket', 'NimbusPost', 'Bluedart'];

for (let i = 109; i <= 150; i++) {
  const name = sampleNames[i % sampleNames.length];
  const loc = sampleCities[i % sampleCities.length];
  const prod = sampleProducts[i % sampleProducts.length];
  const isCod = i % 2 === 0;
  const courier = couriersList[i % couriersList.length];

  INITIAL_ORDERS.push({
    id: `ZYL-908${i}`,
    customer: {
      name: `${name} ${i}`,
      phone: `+91 98${Math.floor(10000000 + Math.random() * 90000000)}`,
      addressLine: `Plot ${10 + i}, Sector ${i % 30 + 1}, Main Market Road`,
      landmark: `Near City Landmark ${i % 10 + 1}`,
      city: loc.city,
      district: loc.district,
      state: loc.state,
      pinCode: loc.pin
    },
    item: {
      productName: prod.name,
      sku: prod.sku,
      quantity: (i % 3) + 1,
      weightKg: Number((prod.w * ((i % 3) + 1)).toFixed(2))
    },
    courier,
    paymentType: isCod ? 'COD' : 'Prepaid',
    codAmount: isCod ? prod.price * ((i % 3) + 1) : 0,
    status: i % 4 === 0 ? 'Printed' : i % 3 === 0 ? 'Label Generated' : 'Pending',
    createdAt: new Date(Date.now() - i * 3600 * 1000).toISOString()
  });
}
